# Copy this file to ".env" and edit it. NEVER put AWS keys in here and NEVER commit ".env".
# AWS credentials come from 'aws configure' (stored in your user folder, outside this project).

# ---- Storage -------------------------------------------------------------
# local = documents stay on your computer (no AWS needed). s3 = documents go to your S3 bucket.
STUDYMATE_STORAGE=local
STUDYMATE_LOCAL_DIR=data/local_docs

# Only needed when STUDYMATE_STORAGE=s3
STUDYMATE_S3_BUCKET=
STUDYMATE_S3_PREFIX=studymate/

# ---- Amazon Bedrock (needed for AI answers) -----------------------------------
AWS_REGION=us-east-1
# Must be a model you have access to in the region above (check the Bedrock console).
# This is the Strands SDK default; change it if it isn't available to you.
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
BEDROCK_MAX_TOKENS=1500

# Optional: use a named AWS CLI profile instead of the default one
# AWS_PROFILE=studymate
